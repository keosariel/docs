  "components": {
    "schemas": {
      "ClusterModel": {
        "properties": {
          "clusterId": {
            "type": "string",
            "title": "Clusterid",
            "description": "The cluster id"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "The title of the cluster (generated by AI)"
          },
          "tldr": {
            "type": "string",
            "title": "Tldr",
            "description": "The tldr of the cluster (generated by AI)"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "description": "The category of the cluster"
          },
          "createdAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ],
            "title": "Createdat",
            "description": "The time the cluster was created"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/FeedModel"
            },
            "type": "array",
            "title": "Members",
            "description": "The list of posts in the cluster"
          },
          "thumbnail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumbnail",
            "description": "The thumbnail of the cluster"
          },
          "uniqueSourcesCount": {
            "type": "integer",
            "title": "Uniquesourcescount",
            "description": "The number of unique sources in the cluster"
          },
          "uniqueVideosSourcesCount": {
            "type": "integer",
            "title": "Uniquevideossourcescount",
            "description": "The number of unique video sources in the cluster"
          }
        },
        "type": "object",
        "required": [
          "clusterId",
          "title",
          "tldr",
          "category",
          "createdAt",
          "members",
          "uniqueSourcesCount",
          "uniqueVideosSourcesCount"
        ],
        "title": "ClusterModel"
      },
      "ClusterSummaryModel": {
        "properties": {
