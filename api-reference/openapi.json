    "/services/media": {
      "get": {
        "tags": [
          "services"
        ],
        "summary": "Recent News",
        "description": "Retrieve recently published news articles\n\nReturns a list of recently published news articles, only\narticles in a cluster (i.e cid is not `None` / `null`) would have `content` and `metadata`\nfields populated.",
        "operationId": "recent_news_services_media_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "The page number to retrieve",
              "default": 1,
              "title": "Page"
            },
            "description": "The page number to retrieve"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 30,
              "minimum": 1,
              "description": "The number of items to retrieve per page",
              "default": 10,
              "title": "Per Page"
            },
            "description": "The number of items to retrieve per page"
          },
          {
            "name": "ally-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ally-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FeedModel"
                  },
                  "title": "Response Recent News Services Media Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/services/media/search": {
      "get": {
        "tags": [
          "services"
        ],
        "summary": "Search Media",
        "description": "Query all news articles that match the search query\n\nAll results are strictly based on the `title` field and \nare sorted by relevance to the query.",
        "operationId": "search_media_services_media_search_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Search query",
              "title": "Query"
            },
            "description": "Search query"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "The page number to retrieve",
              "default": 1,
              "title": "Page"
            },
            "description": "The page number to retrieve"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 30,
              "minimum": 1,
              "description": "The number of items to retrieve per page",
              "default": 10,
              "title": "Per Page"
            },
            "description": "The number of items to retrieve per page"
          },
          {
            "name": "ally-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ally-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FeedModel"
                  },
                  "title": "Response Search Media Services Media Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/services/media/clusters/{cid}": {
      "get": {
        "tags": [
          "services"
        ],
        "summary": "Single Cluster",
        "description": "Retrieve a single cluster details.\n\nNote: all clusters would have the `summary` & `tldr` fields\npopulated, as they are generated on demand i.e (cached when the summary is requested).\n\nIt is important to note that the titles of any given cluster is AI generated,\nand as such, it might not always describe the event in the cluster accurately.",
        "operationId": "single_cluster_services_media_clusters__cid__get",
        "parameters": [
          {
            "name": "cid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Cluster ID",
              "title": "Cid"
            },
            "description": "Cluster ID"
          },
          {
            "name": "ally-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ally-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/services/media/clusters/{cid}/summary": {
      "get": {
        "tags": [
          "services"
        ],
        "summary": "Cluster Summary",
        "description": "Retrieve the summary of a cluster.\n\nThis endpoint is used to generate a summary of a cluster. This summary\nis cached and would be served from cache if available. It is strictly\nbased on the `summary` & `content` fields of the cluster's feeds.",
        "operationId": "cluster_summary_services_media_clusters__cid__summary_get",
        "parameters": [
          {
            "name": "cid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Cluster ID",
              "title": "Cid"
            },
            "description": "Cluster ID"
          },
          {
            "name": "ally-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ally-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Cluster Summary Services Media Clusters  Cid  Summary Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/services/media/clusters": {
      "get": {
        "tags": [
          "services"
        ],
        "summary": "Recent Clusters",
        "description": "Retrieve recently clustered news articles.\n\nThis endpoint is used to retrieve recently clustered news articles.\nIt is important to note that the titles of any given cluster is AI generated,\nand as such, it might not always describe the event in the cluster accurately.\n\nAll the feeds in the cluster are assumed to be related to the same event,\nand as such, the `summary` & `tldr` fields are generated based on the\nassumption that all the feeds are related to the same event.",
        "operationId": "recent_clusters_services_media_clusters_get",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Category",
              "title": "Category"
            },
            "description": "Category"
          },
          {
            "name": "feed_limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5,
              "minimum": 1,
              "description": "The minimum number of feeds each cluster should have",
              "default": 3,
              "title": "Feed Limit"
            },
            "description": "The minimum number of feeds each cluster should have"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "The page number to retrieve",
              "default": 1,
              "title": "Page"
            },
            "description": "The page number to retrieve"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 30,
              "minimum": 1,
              "description": "The number of items to retrieve per page",
              "default": 10,
              "title": "Per Page"
            },
            "description": "The number of items to retrieve per page"
          },
          {
            "name": "ally-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ally-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClusterModel"
                  },
                  "title": "Response Recent Clusters Services Media Clusters Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/services/nairaland/{post_id}": {
      "get": {
        "tags": [
