              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterSummaryModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/services/clusters": {
      "get": {
        "tags": [
          "services"
        ],
        "summary": "Get Clusters",
        "description": "Get a list of clusters based on the provided filters",
        "operationId": "get_clusters_services_clusters_get",
        "parameters": [
          {
            "name": "categories",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The categories to filter by. If no categories are provided, all clusters will be returned.",
              "default": [],
              "title": "Categories"
            },
            "description": "The categories to filter by. If no categories are provided, all clusters will be returned."
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "createdAt",
                "relevanceScore"
              ],
              "default": "createdAt",
              "title": "Sort By"
            }
          },
          {
            "name": "order_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc",
              "title": "Order By"
            }
          },
          {
            "name": "min_unique_sources",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "The minimum number of unique sources in the cluster",
              "default": 2,
              "title": "Min Unique Sources"
            },
            "description": "The minimum number of unique sources in the cluster"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 30,
              "minimum": 1,
              "default": 10,
              "title": "Per Page"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClusterModel"
                  },
                  "title": "Response Get Clusters Services Clusters Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
