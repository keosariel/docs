          "pageContent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pagecontent",
            "description": "The content of the post"
          },
          "publicationDate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ],
            "title": "Publicationdate",
            "description": "The time the post was published"
          },
          "sourceType": {
            "type": "string",
            "title": "Sourcetype",
            "description": "The type of the source"
