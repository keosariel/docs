    },
    "/services/nairaland/{post_id}/comments": {
      "get": {
        "tags": [
          "services"
        ],
        "summary": "Nairaland Post",
        "description": "Retrieve the comments of a Nairaland post.\n\nNote: the comments are cached and would be served from cache if available. Also \nthe comments are sorted by the `timestamp` field in descending order. Comments are nested\nif there are replies to a comment, the replies would be in the `replies` field.\n\nThis endpoint is used to retrieve the comments of a Nairaland post.\nIf the post is not found, it returns an empty list.",
        "operationId": "nairaland_post_services_nairaland__post_id__comments_get",
        "parameters": [
          {
            "name": "post_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Nairaland Post ID",
              "title": "Post Id"
            },
            "description": "Nairaland Post ID"
          },
          {
            "name": "ally-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ally-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NairalandCommentModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
