                    "$ref": "#/components/schemas/ClusterModel"
                  },
                  "title": "Response Get Similar Clusters Services Clusters  Cluster Id  Similar Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/services/clusters/{cluster_id}/summary": {
      "get": {
        "tags": [
          "services"
        ],
        "summary": "Get Cluster Summary",
        "description": "Get the summary and TL;DR of a given cluster",
        "operationId": "get_cluster_summary_services_clusters__cluster_id__summary_get",
        "parameters": [
          {
            "name": "cluster_id",
