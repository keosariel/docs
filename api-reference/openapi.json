        ],
        "summary": "Nairaland Post",
        "description": "Retrieve a Nairaland post data.\n\nThis endpoint is used to retrieve a Nairaland post cached data if available. \nIf the post is not found, the endpoint would return a 404 error.",
        "operationId": "nairaland_post_services_nairaland__post_id__get",
        "parameters": [
          {
            "name": "post_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Nairaland Post ID",
              "title": "Post Id"
            },
            "description": "Nairaland Post ID"
          },
          {
            "name": "ally-api-key",
            "in": "header",
            "required": true,
