  "paths": {
    "/services/sources": {
      "get": {
        "tags": [
          "services"
        ],
        "summary": "Get Sources",
        "description": "Get a list of sources",
        "operationId": "get_sources_services_sources_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SourceModel"
                  },
                  "type": "array",
                  "title": "Response Get Sources Services Sources Get"
                }
              }
            }
          }
        }
      }
    },
    "/services/feed": {
      "get": {
        "tags": [
          "services"
        ],
        "summary": "Get Feed",
        "description": "Get a list of feeds\n\nAll results are strictly based on the `publicationDate`.",
        "operationId": "get_feed_services_feed_get",
        "parameters": [
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "publicationDate"
              ],
              "default": "publicationDate",
              "title": "Sort By"
            }
          },
          {
            "name": "sourceName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The source name to filter by. If no source name is provided, all sources will be returned.",
              "default": [],
              "title": "Sourcename"
            },
            "description": "The source name to filter by. If no source name is provided, all sources will be returned."
          },
          {
            "name": "order_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc",
              "title": "Order By"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 30,
              "minimum": 1,
              "default": 10,
              "title": "Per Page"
            }
          },
          {
            "name": "include_page_content",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Page Content"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FeedModel"
                  },
                  "title": "Response Get Feed Services Feed Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/services/clusters/{cluster_id}": {
      "get": {
